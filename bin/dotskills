#!/usr/bin/env bash
# ==============================================================================
# dotskills — one configuration flow (skills + tools)
#
# Interactive (gum): run with no command in a terminal. One menu for both
# jobs: skill extras, which tools, which repos. Then skills run, then tools.
#
# Flags still work for scripts and CI:
#   ./bin/dotskills skills [install-skills flags]
#   ./bin/dotskills tools  [setup-ai-tools flags]
#   ./bin/dotskills all    [setup-ai-tools flags]  # skills defaults, then tools
#   ./bin/dotskills --no-gum [all|skills|tools] …
# ==============================================================================
set -euo pipefail

# shellcheck source=lib/paths.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/paths.sh"
# shellcheck source=lib/common.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"
# shellcheck source=lib/config.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/config.sh"

ROOT="$(cd "$(script_dir_of "${BASH_SOURCE[0]}")/.." && pwd)"

# Load repo/user config for npx defaults, falling back to the hardcoded list.
load_dotskills_config "$ROOT"
if [ "${#NPX_COMMUNITY[@]}" -eq 0 ]; then
  NPX_COMMUNITY=(
    "igmarin/agnostic-planning-skills"
    "igmarin/ruby-core-skills"
    "igmarin/rails-agent-skills"
    "owainlewis/agent-skills"
    "owainlewis/blueprint"
    "mattpocock/skills"
    "dietrichgebert/ponytail"
  )
fi
declare -a NPX_DEFAULT=("${NPX_COMMUNITY[@]}")

SKILLS="$ROOT/bin/install-skills.sh"
TOOLS="$ROOT/bin/setup-ai-tools.sh"
SKIP_GUM=false

usage() {
  cat <<'EOF'
dotskills — one configuration flow for skills and local AI tools

Interactive (gum):
  ./bin/dotskills
  ./bin/dotskills /path/to/Projects

Commands:
  skills [flags]   owned skill clones + personal skills/
                   Interactive: pick repos from `gh repo list` + custom input
                   --repo owner/repo (repeatable; overrides default list)
                   --npx owner/repo  (repeatable; npx-install a collection)
  tools  [flags]   Serena / CodeGraph / Graphify
                   --provider <name>  (graphify backend: deepseek, openai)
                   --model <name>     (graphify model; default deepseek-v4-pro)
  all    [flags]   skills (defaults), then tools
                   --dry-run is passed to both skills and tools

  --no-gum         skip the TUI even in a terminal

Note: interactive skills mode uses gh (GitHub CLI) to list your repos.
      Install gh and run `gh auth login` first.
EOF
}

want_interactive() {
  [ "$SKIP_GUM" != true ] && [ -t 0 ] && [ -t 1 ]
}

install_gum_and_stop() {
  if ! command -v brew >/dev/null 2>&1; then
    echo "[!] Homebrew not found; cannot install gum."
    echo "    Install gum yourself (https://github.com/charmbracelet/gum) and re-run."
    exit 1
  fi
  echo "[*] Installing gum via Homebrew..."
  brew install gum
  echo ""
  echo "[✓] gum installed. Re-run for the interactive menu:"
  echo "    $0"
  exit 0
}

ask_install_gum_or_continue() {
  echo ""
  echo "[!] gum is not installed. The interactive menu needs it."
  echo "    1) Install gum (brew install gum), then stop — re-run for the TUI"
  echo "    2) Continue without gum (skills defaults, no tools)"
  local ans=""
  while true; do
    printf "Choose 1 or 2: "
    read -r ans || exit 1
    case "$ans" in
      1) install_gum_and_stop ;;
      2)
        echo "[*] Continuing without gum — skills defaults only."
        exec "$SKILLS"
        ;;
      *) echo "    Please enter 1 or 2." ;;
    esac
  done
}

has_line() {
  local haystack="$1" needle="$2"
  case $'\n'"$haystack"$'\n' in *$'\n'"$needle"$'\n'*) return 0 ;; esac
  return 1
}

# Prompt for one or more custom owner/repo slugs and append to an array.
_prompt_custom_repos() {
  local -n arr="$1"
  local custom
  while gum confirm --default=true "Add a custom owner/repo not in the gh list?"; do
    custom="$(gum input --placeholder "owner/repo-name")" || break
    if [ -n "$custom" ] && valid_slug "$custom"; then
      arr+=("$custom")
    else
      echo "[!] Invalid slug: $custom (expected owner/repo)"
    fi
  done
}

# Use gh to list the user's repos and let the user multi-select.
# Also allows custom owner/repo input. Prints selected slugs one per line.
select_gh_repos() {
  if ! command -v gh >/dev/null 2>&1; then
    echo "[*] gh is not installed; using default repo list." >&2
    return 0
  fi
  if ! gh auth status >/dev/null 2>&1; then
    echo "[*] gh is not authenticated (run 'gh auth login'). Using default repo list." >&2
    return 0
  fi

  local -a all=() selected=()
  local raw
  raw="$(gh repo list --json nameWithOwner --limit 50 -t '{{range .}}{{printf "%s\n" .nameWithOwner}}{{end}}' 2>/dev/null)" || {
    echo "[*] gh repo list failed; using default repo list." >&2
    return 0
  }

  mapfile -t all <<< "$raw"

  if [ "${#all[@]}" -eq 0 ]; then
    echo "[*] No repos found via gh; using default repo list." >&2
    return 0
  fi

  local sel
  sel="$(gum choose --no-limit \
    --header "Select skill source repos (space to toggle, enter to confirm)" \
    "${all[@]}")" || return 0

  mapfile -t selected <<< "$sel"

  _prompt_custom_repos selected

  for r in "${selected[@]}"; do
    [ -n "$r" ] && echo "$r"
  done
}

# Prompt for one or more custom npx slugs and append to an array.
_prompt_custom_npx() {
  local -n arr="$1"
  local custom
  while gum confirm --default=true "Add a custom owner/repo for npx skills?"; do
    custom="$(gum input --placeholder "owner/repo-name")" || break
    if [ -n "$custom" ] && valid_slug "$custom"; then
      arr+=("$custom")
    else
      echo "[!] Invalid slug: $custom (expected owner/repo)"
    fi
  done
}

run_unified_gum() {
  local scan_root="$1"
  local jobs extras tools_sel selected_names name npx_sel npx_item
  local run_skills=false run_tools=false
  local with_elixir=false with_rs_guard=false
  local run_serena=true run_codegraph=true run_graphify=true
  local force=false auto_install=true
  local -a repo_names=() selected_repos=() selected_skill_repos=() selected_npx=() skill_args=() tool_args=()

  jobs="$(gum choose --no-limit \
    --header "What to configure? (space to toggle, enter to confirm)" \
    "Skills (owned repos + personal)" \
    "Tools (Serena / CodeGraph / Graphify)")" || exit 1
  [ -n "$jobs" ] || { echo "[!] Nothing selected. Exiting."; exit 1; }
  has_line "$jobs" "Skills (owned repos + personal)" && run_skills=true
  has_line "$jobs" "Tools (Serena / CodeGraph / Graphify)" && run_tools=true

  if $run_skills; then
    # npx skill collections: show recommended list pre-selected, allow custom slugs.
    echo ""
    echo "[*] Select npx skill collections (recommended are pre-selected, space to toggle):"
    local npx_cmd=(gum choose --no-limit --header "npx skill collections")
    for npx_item in "${NPX_DEFAULT[@]}"; do
      npx_cmd+=(--selected "$npx_item")
    done
    for npx_item in "${NPX_DEFAULT[@]}"; do
      npx_cmd+=("$npx_item")
    done
    npx_sel="$("${npx_cmd[@]}")" || npx_sel=""
    if [ -n "$npx_sel" ]; then
      while IFS= read -r r; do
        [ -n "$r" ] && selected_npx+=("$r")
      done <<< "$npx_sel"
    fi
    _prompt_custom_npx selected_npx

    extras="$(gum choose --no-limit \
      --header "Skill extras? (none is fine — space to toggle)" \
      "Elixir Phoenix skills (work)" \
      "setup-rs-guard (opt-in)")" || extras=""
    has_line "$extras" "Elixir Phoenix skills (work)" && with_elixir=true
    has_line "$extras" "setup-rs-guard (opt-in)" && with_rs_guard=true

    echo ""
    echo "[*] Loading repos from gh..."
    while IFS= read -r r; do
      [ -n "$r" ] && selected_skill_repos+=("$r")
    done < <(select_gh_repos)
  fi

  if $run_tools; then
    tools_sel="$(gum choose --no-limit \
      --header "Which tools? (space to toggle, enter to confirm)" \
      Serena CodeGraph Graphify)" || exit 1
    [ -n "$tools_sel" ] || { echo "[!] No tools selected. Exiting."; exit 1; }
    run_serena=false
    run_codegraph=false
    run_graphify=false
    has_line "$tools_sel" Serena && run_serena=true
    has_line "$tools_sel" CodeGraph && run_codegraph=true
    has_line "$tools_sel" Graphify && run_graphify=true

    if gum confirm --default=false "Force rebuild CodeGraph / Graphify?"; then
      force=true
    fi
    if gum confirm --default=true "Install missing tools if they are not on PATH?"; then
      auto_install=true
    else
      auto_install=false
    fi

    scan_root="${scan_root%/}"
    if is_project_dir "$scan_root"; then
      selected_repos=("$scan_root")
    else
      while IFS= read -r name; do
        [ -n "$name" ] && repo_names+=("$name")
      done < <(list_child_repo_names "$scan_root")
      if [ "${#repo_names[@]}" -eq 0 ]; then
        echo "[!] No project folders found in $scan_root"
        exit 1
      fi
      selected_names="$(gum choose --no-limit \
        --header "Which repos to configure? (space to toggle, enter to confirm)" \
        "${repo_names[@]}")" || exit 1
      [ -n "$selected_names" ] || { echo "[!] No repos selected. Exiting."; exit 1; }
      while IFS= read -r name; do
        [ -n "$name" ] && selected_repos+=("$scan_root/$name")
      done <<< "$selected_names"
    fi
  fi

  if $run_skills; then
    $with_elixir && skill_args+=(--with=elixir-phoenix-skills)
    $with_rs_guard && skill_args+=(--with-rs-guard)
    local r
    for r in "${selected_skill_repos[@]}"; do
      skill_args+=(--repo "$r")
    done
    for r in "${selected_npx[@]}"; do
      skill_args+=(--npx "$r")
    done
    echo ""
    echo "==> skills"
    "$SKILLS" "${skill_args[@]+"${skill_args[@]}"}"
  fi

  if $run_tools; then
    $run_serena || tool_args+=(--skip-serena)
    $run_codegraph || tool_args+=(--skip-codegraph)
    $run_graphify || tool_args+=(--skip-graphify)
    $force && tool_args+=(--force)
    $auto_install || tool_args+=(--no-install)
    local repo
    for repo in "${selected_repos[@]}"; do
      tool_args+=(--repo "$repo")
    done
    echo ""
    echo "==> tools"
    "$TOOLS" "${tool_args[@]}"
  fi
}

# --- args ---
POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-gum) SKIP_GUM=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) POSITIONAL+=("$1"); shift ;;
  esac
done
set -- "${POSITIONAL[@]+"${POSITIONAL[@]}"}"

cmd="${1:-}"
scan_hint=""
if [ -n "$cmd" ] && [ -d "$cmd" ] && [[ "$cmd" != skills && "$cmd" != tools && "$cmd" != all ]]; then
  scan_hint="$(cd "$cmd" && pwd)"
  cmd=""
  shift || true
elif [ -n "$cmd" ]; then
  shift || true
fi

case "$cmd" in
  skills)
    exec "$SKILLS" "$@"
    ;;
  tools)
    # setup-ai-tools.sh is the flag-driven tool runner; dotskills already owns the TUI.
    exec "$TOOLS" "$@"
    ;;
  all)
    skill_flags=()
    tool_flags=()
    while [[ $# -gt 0 ]]; do
      a="$1"
      case "$a" in
        --dry-run|--dry-run=true)
          skill_flags+=(--dry-run)
          tool_flags+=(--dry-run)
          shift
          ;;
        --dry-run=false) shift ;;
        --repo)
          if [ -z "${2:-}" ]; then
            echo "Error: --repo needs an argument" >&2
            exit 1
          fi
          if valid_slug "$2"; then
            skill_flags+=(--repo "$2")
          else
            tool_flags+=(--repo "$2")
          fi
          shift 2
          ;;
        --repo=*)
          val="${a#*=}"
          if valid_slug "$val"; then
            skill_flags+=(--repo "$val")
          else
            tool_flags+=(--repo "$val")
          fi
          shift
          ;;
        --npx)
          if [ -z "${2:-}" ]; then
            echo "Error: --npx needs an argument" >&2
            exit 1
          fi
          if valid_slug "$2"; then
            skill_flags+=(--npx "$2")
          else
            echo "Error: invalid --npx slug (expected owner/name): $2" >&2
            exit 1
          fi
          shift 2
          ;;
        --npx=*)
          val="${a#*=}"
          if valid_slug "$val"; then
            skill_flags+=(--npx "$val")
          else
            echo "Error: invalid --npx slug (expected owner/name): $val" >&2
            exit 1
          fi
          shift
          ;;
        --provider)
          if [ -z "${2:-}" ]; then
            echo "Error: --provider needs an argument" >&2
            exit 1
          fi
          tool_flags+=(--provider "$2")
          shift 2
          ;;
        --provider=*)
          tool_flags+=(--provider "${a#*=}")
          shift
          ;;
        --model)
          if [ -z "${2:-}" ]; then
            echo "Error: --model needs an argument" >&2
            exit 1
          fi
          tool_flags+=(--model "$2")
          shift 2
          ;;
        --model=*)
          tool_flags+=(--model "${a#*=}")
          shift
          ;;
        --with-rs-guard|--with=elixir-phoenix-skills|--with=igmarin/elixir-phoenix-skills)
          skill_flags+=("$a"); shift ;;
        --with=*)
          echo "Unknown extra: ${a#*=}" >&2
          echo "Known extras: elixir-phoenix-skills" >&2
          echo "Also: --with-rs-guard  --npx owner/repo" >&2
          exit 1
          ;;
        *) tool_flags+=("$a"); shift ;;
      esac
    done
    if [ "${#skill_flags[@]}" -gt 0 ]; then
      echo "note: skill flags apply to install-skills.sh; remaining args go to setup-ai-tools.sh"
    fi
    echo "==> skills"
    "$SKILLS" "${skill_flags[@]+"${skill_flags[@]}"}"
    echo ""
    echo "==> tools"
    exec "$TOOLS" "${tool_flags[@]+"${tool_flags[@]}"}"
    ;;
  "")
    if want_interactive; then
      if command -v gum >/dev/null 2>&1; then
        run_unified_gum "${scan_hint:-$(dirname "$ROOT")}"
      else
        ask_install_gum_or_continue
      fi
    else
      usage
    fi
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
